# --- Comportamento ---
daemonize
ignore-empty-password
show-failed-attempts
fade-in=0.15

# --- Tipografia & Relógio ---
clock
font="JetBrainsMono Nerd Font"
timestr=%H:%M
# Formato compacto para caber perfeitamente dentro do anel:
datestr=%a, %d de %b

# --- Geometria do Indicador ---
indicator
# Raio expandido para dar respiro ao texto da data:
indicator-radius=125
indicator-thickness=8
indicator-idle-visible
# --- Paleta AMOLED (100% Monocromático Puro) ---

# Fundo sólido (#000000)
color=000000

# Interior do anel
inside-color=000000
inside-clear-color=ffffff
inside-ver-color=cccccc
inside-wrong-color=888888

# Anel externo
ring-color=ffffff
ring-clear-color=ffffff
ring-ver-color=cccccc
ring-wrong-color=888888

# Feedback de digitação
key-hl-color=ffffff
bs-hl-color=888888

# Textos
text-color=ffffff
text-clear-color=000000
text-ver-color=000000
text-wrong-color=ffffff

# Linhas divisórias transparentes
line-color=00000000
separator-color=00000000
