# --- Comportamento ---
daemonize
ignore-empty-password
show-failed-attempts
fade-in=0.15

# --- Tipografia & Relógio ---
clock
font="JetBrainsMono Nerd Font"
timestr=%H:%M
# Formato compacto para caber perfeitamente dentro do anel:
datestr=%a, %d de %b

# --- Geometria do Indicador ---
indicator
# Raio expandido para dar respiro ao texto da data:
indicator-radius=125
indicator-thickness=8
indicator-idle-visible
# --- Paleta Catppuccin Mocha ---

# Fundo sólido (base #1e1e2e)
color=1e1e2e

# Interior do anel (surface0 #313244 / lavender #b4befe / blue #89b4fa / red #f38ba8)
inside-color=313244
inside-clear-color=b4befe
inside-ver-color=89b4fa
inside-wrong-color=f38ba8

# Anel externo (surface2 #585b70 / lavender #b4befe / blue #89b4fa / red #f38ba8)
ring-color=585b70
ring-clear-color=b4befe
ring-ver-color=89b4fa
ring-wrong-color=f38ba8

# Feedback de digitação (green #a6e3a1 / red #f38ba8)
key-hl-color=a6e3a1
bs-hl-color=f38ba8

# Textos (text #cdd6f4 / base #1e1e2e)
text-color=cdd6f4
text-clear-color=1e1e2e
text-ver-color=1e1e2e
text-wrong-color=1e1e2e

# Linhas divisórias transparentes
line-color=00000000
separator-color=00000000
