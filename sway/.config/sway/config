# ==============================================================================
# Sway / SwayFX Configuration
# Local padrão: ~/.config/sway/config
# ==============================================================================

### Variáveis
# ------------------------------------------------------------------------------
# Tecla Mod (Mod4 = Super / Windows, Mod1 = Alt)
set $mod Mod4

# Teclas de direção estilo Vim
set $left h
set $down j
set $up k
set $right l

# Terminal e lançador padrão
set $term kitty
set $menu ~/.config/rofi/scripts/launcher_t4


### Configurações de Input
# ------------------------------------------------------------------------------
# Touchpad
input type:touchpad {
    tap enabled
    natural_scroll enabled
    drag enabled
    drag_lock disabled
}

# Teclado
input type:keyboard {
    xkb_layout "br(thinkpad)"
}

# Mouse
input type:mouse {
    accel_profile "flat"
    pointer_accel 0.0
}


### Configurações de Output / Display
# ------------------------------------------------------------------------------
# Wallpaper padrão de fallback
output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill

# Display integrado (eDP-1)
output eDP-1 {
    mode 1920x1200@60Hz
    scale 1.25
    bg ~/Pictures/Desktop/ign_cyberpunk-01-12.jpg fill
}

# Night Light
exec wlsunset

### Aparência e Efeitos visuais (SwayFX)
# ------------------------------------------------------------------------------
# Bordas e Espaçamentos
default_border none
default_floating_border none
gaps inner 15
corner_radius 10

# Animações
animation_duration_ms 250

# Blur
blur disable
blur_xray disable
blur_passes 4
blur_radius 4
# blur_noise 0.0
# blur_brightness 1.0
# blur_contrast 1.0
# blur_saturation 1.0

# Sombras
shadows disable
shadows_on_csd enable
# shadow_inactive_color #0000007F
# shadow_offset 0 0
# shadow_blur_radius 10
# shadow_color #000000AA

# Dimming (janelas inativas)
# default_dim_inactive 0.0


### Gerenciamento de Ociosidade (Idle)
# ------------------------------------------------------------------------------
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'


### Atalhos de Teclado (Keybindings)
# ------------------------------------------------------------------------------

# --- Básicos ---
# Abrir terminal
bindsym $mod+Return exec $term

# Fechar janela em foco
bindsym $mod+Shift+q kill

# Abrir launcher
bindsym $mod+d exec $menu

# Arrastar e redimensionar janelas flutuantes com o mouse
floating_modifier $mod normal

# Recarregar configuração do Sway
bindsym $mod+Shift+c reload

# Sair do SwayFX
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'Deseja encerrar a sessão do SwayFX?' \
    -B 'Sim, encerrar' 'swaymsg exit'

# --- Navegação de Foco ---
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# --- Movimentação de Janelas ---
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Workspaces ---
# Alternar para workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Mover janela focada para workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# --- Layout e Posicionamento ---
# Divisão de janelas
bindsym $mod+b splith
bindsym $mod+v splitv

# Estilos de layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Tela cheia
bindsym $mod+f fullscreen

# Alternar entre tiling e flutuante
bindsym $mod+Shift+space floating toggle

# Alternar foco entre área em mosaico e flutuante
bindsym $mod+space focus mode_toggle

# Focar no container pai
bindsym $mod+a focus parent

# --- Scratchpad ---
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# --- Modo de Redimensionamento (Resize) ---
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- Teclas Especiais e Multimídia ---
# Áudio (PulseAudio / PipeWire)
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86AudioLowerVolume exec ~/.config/sway/scripts/volume-down.sh
bindsym --locked XF86AudioRaiseVolume exec ~/.config/sway/scripts/volume-up.sh

# Brilho de Tela
bindsym --locked XF86MonBrightnessDown exec ~/.config/sway/scripts/bright-down.sh
bindsym --locked XF86MonBrightnessUp exec ~/.config/sway/scripts/bright-up.sh

# Controle de Mídia (playerctl)
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

# Captura de tela
bindsym Print exec ~/.config/rofi/scripts/screenshot.sh


### Inclusões e Inicialização Automática
# ------------------------------------------------------------------------------
include /etc/sway/config.d/*

# Barra de status
exec waybar

# Agente de autenticação Polkit
exec /usr/libexec/polkit-mate-authentication-agent-1⏎      
